<Window x:Class="NyelvbazisWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NyelvbazisWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Nyelvbázis Adminisztrációs Felület" HorizontalAlignment="Center" FontSize="36" Margin="0, 80"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Felhasználónév:" />
            <TextBox x:Name="UsernameTextBox" Width="200" />
            <TextBlock Text="Jelszó:" Margin="0,10,0,0" />
            <PasswordBox x:Name="PasswordBox" Width="200" />
            <Button x:Name="LoginButton" Content="Bejelentkezés" Click="LoginButton_Click" Margin="0,20,0,0" />
            <Button x:Name="ExitButton" Content="Kilépés" Click="ExitButton_Click" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
